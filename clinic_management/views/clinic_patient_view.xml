<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_clinic_patient_list" model="ir.ui.view">
        <field name="name">clinic.patient.list</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="name"/>
                <field name="age"/>
                <field name="phone_number"/>
                <field name="address"/>
                <field name="appointment_ids"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_clinic_patient_form" model="ir.ui.view">
        <field name="name">clinic.patient.form</field>
        <field name="model">clinic.patient</field>
        <field name="arch" type="xml">
            <form string="Patient">
                <sheet>
                    <group>
                        <field name="patient_id"/>
                        <field name="name"/>
                        <field name="age"/>
                        <field name="phone_number"/>
                        <field name="address"/>
                    </group>
                    <notebook>
                        <page string="Appointments">
                            <field name="appointment_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="appointment_date"/>
                                    <field name="doctor_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_clinic_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="res_model">clinic.patient</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_clinic_root" name="Clinic" sequence="10"/>
    <menuitem id="menu_clinic_patient" name="Patients"
              parent="menu_clinic_root"
              action="action_clinic_patient" sequence="10"/>

</odoo>
