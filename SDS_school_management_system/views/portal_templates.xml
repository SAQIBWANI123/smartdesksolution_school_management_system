<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_my_home_school_links" inherit_id="portal.portal_my_home" name="School Portal Links">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
      <a class="list-group-item list-group-item-action" href="/my/school/fees">
        <span class="fa fa-money me-2"/>My School Fees
      </a>
      <a class="list-group-item list-group-item-action" href="/my/school/students">
        <span class="fa fa-child me-2"/>My Children
      </a>
      <a class="list-group-item list-group-item-action" href="/school/admission">
        <span class="fa fa-pencil me-2"/>Apply for Admission
      </a>
    </xpath>
  </template>

  <template id="portal_admission_form" name="Online Admission Application">
    <t t-call="website.layout"><div id="wrap" class="oe_structure"><section class="container py-5"><div class="row justify-content-center"><div class="col-lg-9"><div class="card shadow-sm border-0"><div class="card-body p-4 p-lg-5"><span class="badge text-bg-primary mb-2">School Admissions</span><h1 class="h2 mb-2">Online Admission Application</h1><p class="text-muted mb-4">Complete the form below and our admissions team will review your application.</p><form action="/school/admission/submit" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-3"><div class="col-md-6"><label class="form-label">Student Name *</label><input class="form-control" name="student_name" required="required"/></div><div class="col-md-6"><label class="form-label">Date of Birth *</label><input class="form-control" type="date" name="date_of_birth" required="required"/></div><div class="col-md-6"><label class="form-label">Gender *</label><select class="form-select" name="gender" required="required"><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></select></div><div class="col-md-6"><label class="form-label">Grade Applying For *</label><select class="form-select" name="grade_id" required="required"><option value="">Select grade</option><t t-foreach="grades" t-as="grade"><option t-att-value="grade.id" t-out="grade.name"/></t></select></div><div class="col-12"><label class="form-label">Academic Year</label><select class="form-select" name="academic_year_id"><option value="">Select academic year</option><t t-foreach="years" t-as="year"><option t-att-value="year.id" t-out="year.name"/></t></select></div><div class="col-12"><hr/><h2 class="h5">Parent / Guardian Details</h2></div><div class="col-md-6"><label class="form-label">Guardian Name *</label><input class="form-control" name="guardian_name" required="required"/></div><div class="col-md-6"><label class="form-label">Relationship</label><input class="form-control" name="guardian_relation" placeholder="Mother, Father, Guardian..."/></div><div class="col-md-6"><label class="form-label">Email *</label><input class="form-control" type="email" name="guardian_email" required="required"/></div><div class="col-md-6"><label class="form-label">Phone *</label><input class="form-control" name="guardian_phone" required="required"/></div><div class="col-12"><label class="form-label">Address</label><textarea class="form-control" name="address" rows="2"/></div><div class="col-12"><label class="form-label">Supporting Documents</label><input class="form-control" type="file" name="documents" multiple="multiple"/><small class="form-text text-muted">You can select multiple supporting documents.</small></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="3"/></div><div class="col-12"><button class="btn btn-primary px-4" type="submit">Submit Application</button></div></div></form></div></div></div></div></section></div></t>
  </template>
  <template id="portal_admission_success" name="Admission Submitted"><t t-call="website.layout"><section class="container py-5 text-center"><div class="alert alert-success mx-auto" style="max-width:680px"><h1 class="h3">Application Submitted</h1><p>Thank you. Your application reference is <strong t-out="admission.name"/>. Our admissions team will contact you after review.</p><a href="/school/admission" class="btn btn-outline-primary me-2">Submit Another Application</a><a href="/web/login?redirect=/my/school/fees" class="btn btn-primary">Parent Fee Portal</a></div></section></t></template>
  <template id="portal_fee_list" name="My School Fees"><t t-call="portal.portal_layout"><t t-set="breadcrumbs_searchbar" t-value="True"/><div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h2>My School Fees</h2><p class="text-muted mb-0">View fee statements and balances for your linked children.</p></div><a href="/my/school/students" class="btn btn-outline-primary"><span class="fa fa-child me-1"/>My Children</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card border-0 bg-light"><div class="card-body"><div class="text-muted">Total billed</div><strong class="fs-4" t-out="total_amount"/></div></div></div><div class="col-md-4"><div class="card border-0 bg-light"><div class="card-body"><div class="text-muted">Total paid</div><strong class="fs-4 text-success" t-out="total_paid"/></div></div></div><div class="col-md-4"><div class="card border-0 bg-light"><div class="card-body"><div class="text-muted">Balance due</div><strong class="fs-4 text-danger" t-out="total_due"/></div></div></div></div><div class="table-responsive"><table class="table table-hover align-middle"><thead><tr><th>Invoice</th><th>Student</th><th>Due Date</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th><th></th></tr></thead><tbody><tr t-foreach="fees" t-as="fee"><td t-out="fee.name"/><td><a t-att-href="'/my/school/students/%s' % fee.student_id.id" t-out="fee.student_id.name"/></td><td t-out="fee.date_due"/><td t-out="fee.amount_total"/><td t-out="fee.amount_paid"/><td t-out="fee.amount_due"/><td t-out="fee_state_labels.get(fee.state)"/><td><a t-att-href="'/my/school/fees/%s' % fee.id" class="btn btn-sm btn-outline-primary">View</a></td></tr><tr t-if="not fees"><td colspan="8" class="text-center text-muted py-4">No fee statements are available.</td></tr></tbody></table></div></div></t></template>
  <template id="portal_student_list" name="My Children"><t t-call="portal.portal_layout"><div class="container py-4"><div class="mb-4"><h2>My Children</h2><p class="text-muted mb-0">View student details, attendance, results and fees for your linked children.</p></div><div class="row g-3"><div t-foreach="students" t-as="student" class="col-md-6"><div class="card h-100"><div class="card-body"><h3 class="h5" t-out="student.name"/><p class="text-muted mb-3"><span t-out="student.grade_id.name"/> <t t-if="student.class_id">- <t t-out="student.class_id.name"/></t></p><a t-att-href="'/my/school/students/%s' % student.id" class="btn btn-outline-primary">View Details</a></div></div></div><div t-if="not students" class="col-12"><div class="alert alert-info">No children are linked to this parent account.</div></div></div></div></t></template>
  <template id="portal_student_detail" name="Student Details"><t t-call="portal.portal_layout"><div class="container py-4"><a href="/my/school/students" class="btn btn-link px-0 mb-3"><span class="fa fa-arrow-left me-1"/>Back to My Children</a><div class="d-flex justify-content-between align-items-start mb-4"><div><h2 t-out="student.name"/><p class="text-muted mb-0"><span t-out="student.grade_id.name"/> <t t-if="student.class_id">- <t t-out="student.class_id.name"/></t></p></div><a t-att-href="'/my/school/fees?student_id=%s' % student.id" class="btn btn-primary">View Fees</a></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Registration ID</div><strong t-out="student.student_id_code"/></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Status</div><strong t-out="student.state"/></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Date of birth</div><strong t-out="student.date_of_birth"/></div></div></div></div><section class="mb-4"><h3 class="h5">Attendance</h3><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Status</th><th>Reason</th></tr></thead><tbody><tr t-foreach="attendance" t-as="line"><td t-out="line.attendance_id.date"/><td t-out="line.state"/><td t-out="line.absence_reason"/></tr><tr t-if="not attendance"><td colspan="3" class="text-muted">No submitted attendance records.</td></tr></tbody></table></div></section><section><h3 class="h5">Exam Results</h3><div class="table-responsive"><table class="table"><thead><tr><th>Exam</th><th>Percentage</th><th>Grade</th><th>Result</th><th>Teacher Comments</th></tr></thead><tbody><tr t-foreach="results" t-as="result"><td t-out="result.exam_id.name"/><td t-out="result.percentage"/><td t-out="result.final_grade"/><td t-out="result.overall_result"/><td t-out="result.teacher_comments"/></tr><tr t-if="not results"><td colspan="5" class="text-muted">No exam results are available.</td></tr></tbody></table></div></section></div></t></template>
  <template id="portal_fee_detail" name="Fee Statement"><t t-call="portal.portal_layout"><div class="container py-4"><a href="/my/school/fees" class="btn btn-link px-0 mb-3"><span class="fa fa-arrow-left me-1"/>Back to My School Fees</a><div class="d-flex justify-content-between align-items-start mb-4"><div><h2 t-out="fee.name"/><p class="text-muted mb-0">Fee statement for <strong t-out="fee.student_id.name"/></p></div><span class="badge text-bg-secondary" t-out="fee_state_labels.get(fee.state)"/></div><div class="row g-3 mb-4"><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Invoice date</div><strong t-out="fee.date_invoice"/></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Due date</div><strong t-out="fee.date_due"/></div></div></div><div class="col-md-4"><div class="card"><div class="card-body"><div class="text-muted">Balance due</div><strong t-out="fee.amount_due"/></div></div></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Fee Head</th><th>Remarks</th><th class="text-end">Amount</th></tr></thead><tbody><tr t-foreach="fee.line_ids" t-as="line"><td t-out="line.fee_head_id.name"/><td t-out="line.remarks"/><td class="text-end" t-out="line.amount"/></tr></tbody><tfoot><tr><th colspan="2">Total</th><th class="text-end" t-out="fee.amount_total"/></tr></tfoot></table></div></div></t></template>
  <template id="portal_admission_form_errors" inherit_id="SDS_school_management_system.portal_admission_form" name="Admission Form Errors">
    <xpath expr="//form[@action='/school/admission/submit']" position="before">
      <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
    </xpath>
  </template>
</odoo>
