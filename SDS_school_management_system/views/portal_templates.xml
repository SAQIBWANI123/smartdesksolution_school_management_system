<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <template id="portal_my_home_school_links" inherit_id="portal.portal_my_home" name="School Portal Links">
    <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
      <a class="list-group-item list-group-item-action" href="/my/school/fees">
        <span class="fa fa-money me-2"/>My School Fees
      </a>
    </xpath>
  </template>

  <template id="portal_admission_form" name="Online Admission Application">
    <t t-call="website.layout"><div id="wrap" class="oe_structure"><section class="container py-5"><div class="row justify-content-center"><div class="col-lg-9"><div class="card shadow-sm border-0"><div class="card-body p-4 p-lg-5"><span class="badge text-bg-primary mb-2">School Admissions</span><h1 class="h2 mb-2">Online Admission Application</h1><p class="text-muted mb-4">Complete the form below and our admissions team will review your application.</p><form action="/school/admission/submit" method="post" enctype="multipart/form-data"><input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/><div class="row g-3"><div class="col-md-6"><label class="form-label">Student Name *</label><input class="form-control" name="student_name" required="required"/></div><div class="col-md-6"><label class="form-label">Date of Birth *</label><input class="form-control" type="date" name="date_of_birth" required="required"/></div><div class="col-md-6"><label class="form-label">Gender *</label><select class="form-select" name="gender" required="required"><option value="male">Male</option><option value="female">Female</option><option value="other">Other</option></select></div><div class="col-md-6"><label class="form-label">Grade Applying For *</label><select class="form-select" name="grade_id" required="required"><option value="">Select grade</option><t t-foreach="grades" t-as="grade"><option t-att-value="grade.id" t-out="grade.name"/></t></select></div><div class="col-12"><label class="form-label">Academic Year</label><select class="form-select" name="academic_year_id"><option value="">Select academic year</option><t t-foreach="years" t-as="year"><option t-att-value="year.id" t-out="year.name"/></t></select></div><div class="col-12"><hr/><h2 class="h5">Parent / Guardian Details</h2></div><div class="col-md-6"><label class="form-label">Guardian Name *</label><input class="form-control" name="guardian_name" required="required"/></div><div class="col-md-6"><label class="form-label">Relationship</label><input class="form-control" name="guardian_relation" placeholder="Mother, Father, Guardian..."/></div><div class="col-md-6"><label class="form-label">Email *</label><input class="form-control" type="email" name="guardian_email" required="required"/></div><div class="col-md-6"><label class="form-label">Phone *</label><input class="form-control" name="guardian_phone" required="required"/></div><div class="col-12"><label class="form-label">Address</label><textarea class="form-control" name="address" rows="2"/></div><div class="col-12"><label class="form-label">Supporting Documents</label><input class="form-control" type="file" name="documents" multiple="multiple"/><small class="form-text text-muted">You can select multiple supporting documents.</small></div><div class="col-12"><label class="form-label">Notes</label><textarea class="form-control" name="notes" rows="3"/></div><div class="col-12"><button class="btn btn-primary px-4" type="submit">Submit Application</button></div></div></form></div></div></div></div></section></div></t>
  </template>
  <template id="portal_admission_success" name="Admission Submitted"><t t-call="website.layout"><section class="container py-5 text-center"><div class="alert alert-success mx-auto" style="max-width:680px"><h1 class="h3">Application Submitted</h1><p class="mb-0">Thank you. Your application reference is <strong t-out="admission.name"/>. Our admissions team will contact you after review.</p></div></section></t></template>
  <template id="portal_fee_list" name="My School Fees"><t t-call="portal.portal_layout"><t t-set="breadcrumbs_searchbar" t-value="True"/><div class="container"><h2>My School Fees</h2><p class="text-muted">Your student invoices, payment status and outstanding balances.</p><table class="table table-hover"><thead><tr><th>Invoice</th><th>Student</th><th>Due Date</th><th>Total</th><th>Paid</th><th>Balance</th><th>Status</th></tr></thead><tbody><tr t-foreach="fees" t-as="fee"><td t-out="fee.name"/><td t-out="fee.student_id.name"/><td t-out="fee.date_due"/><td t-out="fee.amount_total"/><td t-out="fee.amount_paid"/><td t-out="fee.amount_due"/><td t-out="fee.state"/></tr><tr t-if="not fees"><td colspan="7" class="text-center text-muted">No fee statements are available.</td></tr></tbody></table></div></t></template>
  <template id="portal_admission_form_errors" inherit_id="SDS_school_management_system.portal_admission_form" name="Admission Form Errors">
    <xpath expr="//form[@action='/school/admission/submit']" position="before">
      <div t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
    </xpath>
  </template>
</odoo>
