<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_parent_tree" model="ir.ui.view">
        <field name="name">school.parent.list</field>
        <field name="model">school.parent</field>
        <field name="arch" type="xml">
            <list string="Parents / Guardians">
                <field name="name"/>
                <field name="relation_type"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="occupation"/>
            </list>
        </field>
    </record>

    <record id="view_school_parent_form" model="ir.ui.view">
        <field name="name">school.parent.form</field>
        <field name="model">school.parent</field>
        <field name="arch" type="xml">
            <form string="Parent / Guardian Profile">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Full Name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Guardian Information">
                            <field name="relation_type"/>
                            <field name="occupation"/>
                            <field name="annual_income"/>
                            <field name="emergency_contact"/>
                        </group>
                        <group string="Contact Info">
                            <field name="phone"/>
                            <field name="mobile"/>
                            <field name="email"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Children / Wards">
                            <field name="student_ids">
                                <list>
                                    <field name="student_id_code"/>
                                    <field name="name"/>
                                    <field name="grade_id"/>
                                    <field name="class_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_parent" model="ir.actions.act_window">
        <field name="name">Parents / Guardians</field>
        <field name="res_model">school.parent</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_school_parent"
              name="Parents &amp; Guardians"
              parent="menu_school_students_root"
              action="action_school_parent"
              sequence="3"/>
</odoo>
