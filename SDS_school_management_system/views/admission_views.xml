<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_admission_tree" model="ir.ui.view">
        <field name="name">school.admission.tree</field><field name="model">school.admission</field>
        <field name="arch" type="xml"><list><field name="name"/><field name="student_name"/><field name="guardian_name"/><field name="grade_id"/><field name="guardian_phone"/><field name="state"/></list></field>
    </record>
    <record id="view_school_admission_form" model="ir.ui.view">
        <field name="name">school.admission.form</field><field name="model">school.admission</field>
        <field name="arch" type="xml"><form><header><button name="action_review" type="object" string="Start Review" invisible="state != 'new'"/><button name="action_approve" type="object" string="Approve &amp; Enrol" class="btn-primary" invisible="state not in ['new','review']"/><button name="action_reject" type="object" string="Reject" invisible="state not in ['new','review']"/><field name="state" widget="statusbar" statusbar_visible="new,review,approved,rejected"/></header><sheet><div class="oe_title"><h1><field name="name" readonly="1"/></h1></div><group><group string="Applicant"><field name="student_name"/><field name="date_of_birth"/><field name="gender"/><field name="grade_id"/><field name="academic_year_id"/></group><group string="Guardian"><field name="guardian_name"/><field name="guardian_relation"/><field name="guardian_email"/><field name="guardian_phone"/></group></group><notebook><page string="Additional Information"><field name="address"/><field name="notes"/></page><page string="Documents"><field name="document_ids" widget="many2many_attachments"/></page></notebook></sheet></form></field>
    </record>
    <record id="action_school_admission" model="ir.actions.act_window"><field name="name">Admission Applications</field><field name="res_model">school.admission</field><field name="view_mode">list,form</field></record>
    <menuitem id="menu_school_admission" name="Admissions" parent="menu_school_students_root" action="action_school_admission" sequence="1"/>
</odoo>
