<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="SDS_school_management_system.SchoolDashboard">
        <main class="sds_dashboard">

            <!-- ── HEADER ───────────────────────────────────────────── -->
            <header class="sds_header">
                <div class="sds_header_left">
                    <div class="sds_header_badge">
                        <i class="fa fa-graduation-cap"/>
                        <span>SmartDesk School</span>
                    </div>
                    <h1 class="sds_header_title">
                        <t t-esc="getGreeting()"/>,
                        <span class="sds_highlight"><t t-esc="env.services.user ? env.services.user.userName : 'there'"/></span> 👋
                    </h1>
                    <p class="sds_header_sub">Here's what's happening at your school today.</p>
                </div>
                <div class="sds_header_actions">
                    <button class="sds_btn_ghost" t-on-click="loadDashboard" title="Refresh dashboard">
                        <i class="fa fa-refresh"/> Refresh
                    </button>
                    <button class="sds_btn_primary" data-action="SDS_school_management_system.action_school_admission" t-on-click="openAction">
                        <i class="fa fa-plus"/> New Admission
                    </button>
                </div>
            </header>

            <!-- ── LOADING / ERROR ──────────────────────────────────── -->
            <t t-if="state.loading">
                <div class="sds_loading_wrap">
                    <div class="sds_spinner"/>
                    <p>Loading dashboard…</p>
                </div>
            </t>
            <t t-elif="state.error">
                <div class="sds_error_wrap">
                    <i class="fa fa-exclamation-circle"/>
                    <p>Dashboard data could not be loaded. Please refresh or check your access rights.</p>
                    <button class="sds_btn_primary" t-on-click="loadDashboard">Try Again</button>
                </div>
            </t>
            <t t-else="">

                <!-- ── KPI CARDS ──────────────────────────────────────── -->
                <section class="sds_kpi_row">

                    <button class="sds_kpi sds_kpi_indigo"
                            data-action="SDS_school_management_system.action_school_student"
                            t-on-click="openAction">
                        <div class="sds_kpi_ring">
                            <svg viewBox="0 0 56 56" class="sds_ring_svg">
                                <circle cx="28" cy="28" r="22" class="sds_ring_bg"/>
                                <circle cx="28" cy="28" r="22" class="sds_ring_fill" style="stroke-dasharray: 88 138; stroke: rgba(255,255,255,.7)"/>
                            </svg>
                            <i class="fa fa-users"/>
                        </div>
                        <div class="sds_kpi_body">
                            <span class="sds_kpi_label">Total Students</span>
                            <strong class="sds_kpi_value"><t t-esc="formatNumber(state.metrics.students)"/></strong>
                            <span class="sds_kpi_sub">
                                <i class="fa fa-circle sds_dot_green"/> <t t-esc="formatNumber(state.metrics.enrolledStudents)"/> enrolled
                            </span>
                        </div>
                        <i class="fa fa-arrow-right sds_kpi_arrow"/>
                    </button>

                    <button class="sds_kpi sds_kpi_amber"
                            data-action="SDS_school_management_system.action_school_admission"
                            t-on-click="openAction">
                        <div class="sds_kpi_ring">
                            <svg viewBox="0 0 56 56" class="sds_ring_svg">
                                <circle cx="28" cy="28" r="22" class="sds_ring_bg"/>
                                <circle cx="28" cy="28" r="22" class="sds_ring_fill" style="stroke-dasharray: 55 138; stroke: rgba(255,255,255,.7)"/>
                            </svg>
                            <i class="fa fa-inbox"/>
                        </div>
                        <div class="sds_kpi_body">
                            <span class="sds_kpi_label">Pending Admissions</span>
                            <strong class="sds_kpi_value"><t t-esc="formatNumber(state.metrics.pendingAdmissions)"/></strong>
                            <span class="sds_kpi_sub"><i class="fa fa-clock-o"/> awaiting review</span>
                        </div>
                        <i class="fa fa-arrow-right sds_kpi_arrow"/>
                    </button>

                    <button class="sds_kpi sds_kpi_teal"
                            data-action="SDS_school_management_system.action_school_teacher"
                            t-on-click="openAction">
                        <div class="sds_kpi_ring">
                            <svg viewBox="0 0 56 56" class="sds_ring_svg">
                                <circle cx="28" cy="28" r="22" class="sds_ring_bg"/>
                                <circle cx="28" cy="28" r="22" class="sds_ring_fill" style="stroke-dasharray: 100 138; stroke: rgba(255,255,255,.7)"/>
                            </svg>
                            <i class="fa fa-graduation-cap"/>
                        </div>
                        <div class="sds_kpi_body">
                            <span class="sds_kpi_label">Teaching Staff</span>
                            <strong class="sds_kpi_value"><t t-esc="formatNumber(state.metrics.teachers)"/></strong>
                            <span class="sds_kpi_sub"><i class="fa fa-check-circle"/> active records</span>
                        </div>
                        <i class="fa fa-arrow-right sds_kpi_arrow"/>
                    </button>

                    <button class="sds_kpi sds_kpi_rose"
                            data-action="SDS_school_management_system.action_school_student_fee"
                            t-on-click="openAction">
                        <div class="sds_kpi_ring">
                            <svg viewBox="0 0 56 56" class="sds_ring_svg">
                                <circle cx="28" cy="28" r="22" class="sds_ring_bg"/>
                                <circle cx="28" cy="28" r="22" class="sds_ring_fill" style="stroke-dasharray: 70 138; stroke: rgba(255,255,255,.7)"/>
                            </svg>
                            <i class="fa fa-credit-card"/>
                        </div>
                        <div class="sds_kpi_body">
                            <span class="sds_kpi_label">Outstanding Fees</span>
                            <strong class="sds_kpi_value"><t t-esc="formatAmount(state.metrics.totalDue)"/></strong>
                            <span class="sds_kpi_sub"><i class="fa fa-bar-chart"/> of <t t-esc="formatAmount(state.metrics.totalBilled)"/> billed</span>
                        </div>
                        <i class="fa fa-arrow-right sds_kpi_arrow"/>
                    </button>

                </section>

                <!-- ── MAIN GRID ──────────────────────────────────────── -->
                <section class="sds_main_grid">

                    <!-- LEFT COLUMN -->
                    <div class="sds_col_left">

                        <!-- Recent Admissions Table -->
                        <div class="sds_card">
                            <div class="sds_card_head">
                                <div>
                                    <p class="sds_eyebrow"><i class="fa fa-bell-o"/> Latest Activity</p>
                                    <h2>Recent Admissions</h2>
                                </div>
                                <button class="sds_link_btn"
                                        data-action="SDS_school_management_system.action_school_admission"
                                        t-on-click="openAction">
                                    View all <i class="fa fa-long-arrow-right"/>
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="sds_table">
                                    <thead>
                                        <tr>
                                            <th>Application</th>
                                            <th>Student Name</th>
                                            <th>Grade</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="state.admissions" t-as="adm" t-key="adm.id">
                                            <td>
                                                <span class="sds_ref"><i class="fa fa-file-text-o"/> <t t-esc="adm.name"/></span>
                                            </td>
                                            <td>
                                                <div class="sds_avatar_row">
                                                    <div class="sds_avatar"><t t-esc="(adm.student_name || 'N')[0].toUpperCase()"/></div>
                                                    <span><t t-esc="adm.student_name"/></span>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="sds_tag_grade"><t t-esc="adm.grade_id ? adm.grade_id[1] : '—'"/></span>
                                            </td>
                                            <td>
                                                <span t-attf-class="sds_badge sds_badge_#{adm.state}">
                                                    <t t-esc="formatStatus(adm.state)"/>
                                                </span>
                                            </td>
                                        </tr>
                                        <tr t-if="!state.admissions.length">
                                            <td colspan="4" class="sds_empty_cell">
                                                <i class="fa fa-inbox"/> No admission applications yet.
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Quick Shortcuts -->
                        <div class="sds_card sds_shortcuts_card">
                            <div class="sds_card_head">
                                <div>
                                    <p class="sds_eyebrow"><i class="fa fa-th"/> Workspaces</p>
                                    <h2>Quick Access</h2>
                                </div>
                            </div>
                            <div class="sds_shortcuts_grid">
                                <button class="sds_shortcut sds_sc_indigo"
                                        data-action="SDS_school_management_system.action_school_student"
                                        t-on-click="openAction">
                                    <div class="sds_sc_icon"><i class="fa fa-users"/></div>
                                    <span>Students</span>
                                    <small>Directory &amp; enrollment</small>
                                </button>
                                <button class="sds_shortcut sds_sc_teal"
                                        data-action="SDS_school_management_system.action_school_attendance"
                                        t-on-click="openAction">
                                    <div class="sds_sc_icon"><i class="fa fa-check-square-o"/></div>
                                    <span>Attendance</span>
                                    <small>Daily registers</small>
                                </button>
                                <button class="sds_shortcut sds_sc_amber"
                                        data-action="SDS_school_management_system.action_school_exam"
                                        t-on-click="openAction">
                                    <div class="sds_sc_icon"><i class="fa fa-bar-chart"/></div>
                                    <span>Examinations</span>
                                    <small>Results &amp; grading</small>
                                </button>
                                <button class="sds_shortcut sds_sc_blue"
                                        data-action="SDS_school_management_system.action_school_library_book"
                                        t-on-click="openAction">
                                    <div class="sds_sc_icon"><i class="fa fa-book"/></div>
                                    <span>Library</span>
                                    <small>Books &amp; issues</small>
                                </button>
                                <button class="sds_shortcut sds_sc_purple"
                                        data-action="SDS_school_management_system.action_school_dashboard_students"
                                        t-on-click="openAction">
                                    <div class="sds_sc_icon"><i class="fa fa-line-chart"/></div>
                                    <span>Analytics</span>
                                    <small>Trends &amp; stats</small>
                                </button>
                                <button class="sds_shortcut sds_sc_rose"
                                        data-action="SDS_school_management_system.action_school_student_fee"
                                        t-on-click="openAction">
                                    <div class="sds_sc_icon"><i class="fa fa-money"/></div>
                                    <span>Fee Statements</span>
                                    <small>Invoices &amp; payments</small>
                                </button>
                            </div>
                        </div>

                    </div>

                    <!-- RIGHT COLUMN -->
                    <div class="sds_col_right">

                        <!-- Fee Summary Card -->
                        <div class="sds_card sds_fee_card">
                            <div class="sds_card_head">
                                <div>
                                    <p class="sds_eyebrow"><i class="fa fa-pie-chart"/> Finance</p>
                                    <h2>Fee Overview</h2>
                                </div>
                                <button class="sds_link_btn"
                                        data-action="SDS_school_management_system.action_school_dashboard_fees"
                                        t-on-click="openAction">
                                    Analytics <i class="fa fa-long-arrow-right"/>
                                </button>
                            </div>

                            <!-- Donut-style summary -->
                            <div class="sds_fee_summary">
                                <div class="sds_fee_donut">
                                    <svg viewBox="0 0 80 80">
                                        <circle cx="40" cy="40" r="32" class="sds_donut_bg"/>
                                        <circle cx="40" cy="40" r="32" class="sds_donut_paid"
                                                t-att-style="'stroke-dasharray: ' + getDashArray(state.metrics.totalPaid, state.metrics.totalBilled) + '; stroke-dashoffset: -50'"/>
                                    </svg>
                                    <div class="sds_donut_label">
                                        <strong><t t-esc="getCollectionPct()"/>%</strong>
                                        <small>collected</small>
                                    </div>
                                </div>
                                <div class="sds_fee_nums">
                                    <div class="sds_fee_num">
                                        <span class="sds_fee_dot sds_dot_green"/>
                                        <div>
                                            <small>Collected</small>
                                            <strong><t t-esc="formatAmount(state.metrics.totalPaid)"/></strong>
                                        </div>
                                    </div>
                                    <div class="sds_fee_num">
                                        <span class="sds_fee_dot sds_dot_red"/>
                                        <div>
                                            <small>Outstanding</small>
                                            <strong><t t-esc="formatAmount(state.metrics.totalDue)"/></strong>
                                        </div>
                                    </div>
                                    <div class="sds_fee_num">
                                        <span class="sds_fee_dot sds_dot_gray"/>
                                        <div>
                                            <small>Total Billed</small>
                                            <strong><t t-esc="formatAmount(state.metrics.totalBilled)"/></strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Per-state progress bars -->
                            <div class="sds_fee_bars">
                                <div t-foreach="state.feeStates" t-as="fs" t-key="fs.label" class="sds_fee_bar_row">
                                    <div class="sds_fee_bar_meta">
                                        <span><t t-esc="fs.label"/></span>
                                        <strong><t t-esc="formatAmount(fs.amount)"/></strong>
                                    </div>
                                    <div class="sds_prog_track">
                                        <div class="sds_prog_fill" t-att-style="'width: ' + fs.percentage + '%'"/>
                                    </div>
                                    <span class="sds_prog_pct"><t t-esc="fs.percentage"/>%</span>
                                </div>
                                <p t-if="!state.feeStates.length" class="sds_empty_cell">No fee data yet.</p>
                            </div>
                        </div>

                        <!-- Enrollment Snapshot -->
                        <div class="sds_card sds_enroll_card">
                            <div class="sds_card_head">
                                <div>
                                    <p class="sds_eyebrow"><i class="fa fa-users"/> Enrollment</p>
                                    <h2>Student Snapshot</h2>
                                </div>
                            </div>
                            <div class="sds_enroll_stats">
                                <div class="sds_enroll_stat">
                                    <div class="sds_enroll_icon sds_ic_indigo"><i class="fa fa-user-plus"/></div>
                                    <div>
                                        <strong><t t-esc="formatNumber(state.metrics.students)"/></strong>
                                        <small>Total Registered</small>
                                    </div>
                                </div>
                                <div class="sds_enroll_div"/>
                                <div class="sds_enroll_stat">
                                    <div class="sds_enroll_icon sds_ic_teal"><i class="fa fa-check"/></div>
                                    <div>
                                        <strong><t t-esc="formatNumber(state.metrics.enrolledStudents)"/></strong>
                                        <small>Currently Enrolled</small>
                                    </div>
                                </div>
                                <div class="sds_enroll_div"/>
                                <div class="sds_enroll_stat">
                                    <div class="sds_enroll_icon sds_ic_amber"><i class="fa fa-inbox"/></div>
                                    <div>
                                        <strong><t t-esc="formatNumber(state.metrics.pendingAdmissions)"/></strong>
                                        <small>Pending Admissions</small>
                                    </div>
                                </div>
                            </div>
                            <!-- Enrollment bar -->
                            <div class="sds_enroll_bar_wrap">
                                <div class="sds_enroll_bar_track">
                                    <div class="sds_enroll_bar_fill"
                                         t-att-style="'width: ' + getEnrollPct() + '%'"/>
                                </div>
                                <span class="sds_enroll_pct"><t t-esc="getEnrollPct()"/>% enrollment rate</span>
                            </div>
                        </div>

                    </div>
                </section>

            </t>
        </main>
    </t>
</templates>
